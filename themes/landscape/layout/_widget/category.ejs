<% if (site.categories.length){ %>
  <div class="widget-wrap">
    <h3 class="widget-title"><%= __('categories') %></h3>
    <div class="widget">
      <% /* Collapse selected navigation branches; keep article categories intact. */ %>
      <% const collapsedIds = site.categories.find({name: {$in: ['推荐算法', 'flink']}, parent: {$exists: false}}).map(category => category._id); %>
      <%- list_categories(site.categories.find({parent: {$nin: collapsedIds}}), {show_count: theme.show_count}) %>
    </div>
  </div>
<% } %>
