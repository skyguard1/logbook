// Keep the drawer out of the layout until explicitly opened on mobile.
#mobile-nav
  display: none
  @media mq-mobile
    position: fixed
    top: 0
    bottom: 0
    left: 0
    width: mobile-nav-width
    padding: 20px 0
    box-sizing: border-box
    overflow-y: auto
    background: color-mobile-nav-background
    z-index: 2
    .mobile-nav-on &
      display: block

.mobile-nav-link
  display: block
  padding: 14px 20px
  color: #ddd
  text-decoration: none
  line-height: 1.5
  &:hover, &:focus-visible
    color: #fff
    background: #303030
  &:focus-visible
    outline: 2px solid color-link
    outline-offset: -2px
